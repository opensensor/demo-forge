{
  "name": "@demoforge/test-utils",
  "version": "1.0.0",
  "private": true,
  "description": "DemoForge test utilities — mock LLM server, shared test helpers, and fixtures",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock-llm-server": {
      "types": "./dist/mock-llm-server.d.ts",
      "import": "./dist/mock-llm-server.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@demoforge/core": "1.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
