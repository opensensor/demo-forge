  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch"
  },
  "dependencies": {
    "@demoforge/browser": "1.0.0",
    "@demoforge/core": "1.0.0",
    "@demoforge/renderer": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.9.0"
  },
  "license": "GPL-3.0-only"
}
