{
  "name": "@demoforge/studio",
  "version": "1.0.0",
  "private": true,
  "description": "DemoForge Studio — web UI for crafting AI-driven demos from stated objectives",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
