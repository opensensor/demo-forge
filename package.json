{
  "name": "demoforge",
  "version": "1.0.0",
  "private": true,
  "description": "LLM-driven web product demo automation framework",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/core packages/browser packages/cli packages/renderer packages/site",
    "watch": "tsc --build --watch packages/core packages/browser packages/cli packages/renderer packages/site",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.2.0"
  }
}
