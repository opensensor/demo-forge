{
  "name": "demoforge",
  "version": "1.0.0",
  "private": true,
  "description": "LLM-driven web product demo automation framework",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/cli packages/renderer packages/test-utils packages/studio",
    "watch": "tsc --build --watch packages/cli packages/renderer packages/test-utils packages/studio",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  },
  "license": "GPL-3.0-only"
}
